---
// The scroll-driven architecture animation Nicholas built for Materialize, shown in a contained
// panel: scrolling inside the panel steps through the six diagram states (300 ms crossfade, the
// production timing) while notes on the design decisions scroll beside it.
// Step 4's clock and color-cycling boxes are CSS animations inside step-4.svg, as in production.
interface Note {
  title: string;
  text: string;
}
interface Props {
  label: string;
  notes: Note[];
}

const { label, notes } = Astro.props;
---

<section class="sx" aria-label={label}>
  <div class="sx-head">
    <p class="eyebrow">{label}</p>
    <p class="sx-count" aria-hidden="true"><span class="sx-n">1</span> / {notes.length}</p>
  </div>
  <div class="sx-panel" tabindex="0" aria-label="Scrollable demo: scroll inside to step through the animation">
    <div class="sx-grid">
      <div class="sx-graph">
        <div class="sx-frame">
          {
            notes.map((_, i) => (
              <img
                class:list={['sx-state', { on: i === 0 }]}
                src={`/work/materialize/how-it-works/step-${i + 1}.svg`}
                alt={i === 0 ? 'Materialize architecture diagram, built up in six steps' : ''}
                width="1920"
                height="1080"
                loading="lazy"
                decoding="async"
              />
            ))
          }
        </div>
      </div>
      <ol class="sx-notes">
        {
          notes.map((n, i) => (
            <li class="sx-note" data-step={i + 1}>
              <h3>{n.title}</h3>
              <p>{n.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
    <p class="sx-hint" aria-hidden="true"><span class="sx-mouse"></span>Scroll in this section</p>
  </div>
</section>

<style>
  .sx {
    --mz-bg: oklch(0.1726 0.0425 289.97);
    --h: min(78vh, 620px);
    margin: 48px 0;
  }
  .sx-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 12px;
  }
  .sx-count {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
    margin: 0;
  }
  .sx-panel {
    position: relative;
    height: var(--h);
    overflow-y: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--mz-bg);
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.2) transparent;
  }
  .sx-panel:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .sx-grid {
    display: grid;
    grid-template-columns: 1.7fr 1fr;
    gap: 32px;
    padding: 0 32px;
  }
  .sx-graph {
    position: sticky;
    top: 0;
    height: var(--h);
    display: flex;
    align-items: center;
  }
  .sx-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 1920 / 1080;
  }
  .sx-state {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 300ms linear;
  }
  .sx-state.on {
    opacity: 1;
  }
  .sx-notes {
    list-style: none;
    margin: 0;
    padding: calc(var(--h) * 0.3) 0 calc(var(--h) * 0.45);
  }
  .sx-note {
    min-height: calc(var(--h) * 0.6);
    /* --f: 1 in focus, 0 at the panel edge; set from scroll position. */
    --f: 0;
    opacity: calc(0.15 + 0.85 * var(--f));
    filter: blur(calc((1 - var(--f)) * 8px));
    transform: translateY(calc((1 - var(--f)) * var(--dir, 1) * 12px));
    will-change: filter, opacity, transform;
  }
  .sx-note h3 {
    font-size: 22px;
    letter-spacing: -0.01em;
    color: var(--text);
    margin: 0 0 8px;
  }
  .sx-note p {
    color: var(--muted);
    margin: 0;
    font-size: 16px;
  }
  .sx-hint {
    position: sticky;
    bottom: 16px;
    margin: 0 auto;
    width: max-content;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    border-radius: 999px;
    background: rgba(13, 13, 15, 0.75);
    border: 1px solid rgba(255, 255, 255, 0.12);
    font-size: 13px;
    color: var(--text);
    pointer-events: none;
    transition: opacity 0.4s;
  }
  .sx-panel.scrolled .sx-hint {
    opacity: 0;
  }
  .sx-mouse {
    position: relative;
    width: 14px;
    height: 20px;
    border: 1.5px solid currentColor;
    border-radius: 7px;
  }
  .sx-mouse::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 4px;
    width: 2px;
    height: 4px;
    margin-left: -1px;
    border-radius: 1px;
    background: currentColor;
    animation: sx-wheel 1.4s ease-in-out infinite;
  }
  @keyframes sx-wheel {
    0% { transform: translateY(0); opacity: 1; }
    70% { transform: translateY(6px); opacity: 0; }
    100% { transform: translateY(0); opacity: 0; }
  }
  @media (max-width: 760px) {
    .sx {
      --h: min(80vh, 640px);
    }
    .sx-grid {
      grid-template-columns: 1fr;
      gap: 0;
      padding: 0 16px;
    }
    .sx-graph {
      height: auto;
      padding: 16px 0;
      background: var(--mz-bg);
      z-index: 1;
    }
    .sx-notes {
      padding: 24px 0 calc(var(--h) * 0.5);
    }
    .sx-note {
      min-height: calc(var(--h) * 0.45);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sx-state {
      transition: none;
    }
    .sx-note {
      filter: none;
      transform: none;
    }
    .sx-mouse::after {
      animation: none;
    }
  }
</style>

<script>
  // A note becomes active when it reaches the middle of the panel (the production trigger,
  // scoped to the panel instead of the page).
  for (const root of document.querySelectorAll<HTMLElement>('.sx')) {
    const panel = root.querySelector<HTMLElement>('.sx-panel')!;
    const states = [...root.querySelectorAll<HTMLImageElement>('.sx-state')];
    const notes = [...root.querySelectorAll<HTMLElement>('.sx-note')];
    const count = root.querySelector<HTMLElement>('.sx-n')!;
    const show = (n: number) => {
      states.forEach((s, i) => s.classList.toggle('on', i === n - 1));
      notes.forEach((s, i) => s.classList.toggle('on', i === n - 1));
      count.textContent = String(n);
    };
    show(1);
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) show(Number((e.target as HTMLElement).dataset.step));
        }
      },
      { root: panel, rootMargin: '-40% 0px -40% 0px', threshold: 0 },
    );
    notes.forEach((el) => io.observe(el));
    panel.addEventListener('scroll', () => panel.classList.add('scrolled'), { once: true, passive: true });

    // Scroll-linked focus: each note is fully sharp and opaque across the middle of the panel,
    // then eases to blurred and faint toward the top and bottom edges.
    const PLATEAU = 0.22; // half-width of the in-focus band, as a fraction of panel height
    const RANGE = 0.36; // distance over which it eases out past the band
    const ease = (t: number) => t * t * (3 - 2 * t);
    let queued = false;
    const focus = () => {
      queued = false;
      const p = panel.getBoundingClientRect();
      const mid = p.top + p.height / 2;
      for (const n of notes) {
        const head = n.querySelector('h3')!.getBoundingClientRect();
        const center = (head.top + n.querySelector('p')!.getBoundingClientRect().bottom) / 2;
        const d = (center - mid) / p.height;
        const out = Math.min(1, Math.max(0, (Math.abs(d) - PLATEAU) / RANGE));
        n.style.setProperty('--f', String(1 - ease(out)));
        n.style.setProperty('--dir', d < 0 ? '-1' : '1');
      }
    };
    const request = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(focus);
      }
    };
    panel.addEventListener('scroll', request, { passive: true });
    addEventListener('resize', request);
    focus();
  }
</script>
