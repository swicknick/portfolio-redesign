---
// Scroll-driven Lottie story: the stage stays pinned while steps scroll past, and each step's
// animation is scrubbed frame by frame by scroll position. Reduced motion shows a still frame.
interface Step {
  src: string;
  title: string;
  text: string;
}
interface Props {
  steps: Step[];
  ratio?: string;
}

const { steps, ratio = '16 / 9' } = Astro.props;
---

<section class="scrolly">
  <div class="stage-wrap">
    <div class="stage" style={`aspect-ratio: ${ratio}`}>
      {steps.map((s, i) => <div class="anim" data-src={s.src} data-i={i} aria-hidden="true" />)}
      <div class="progress" aria-hidden="true"><span></span></div>
    </div>
  </div>
  <ol class="steps">
    {
      steps.map((s, i) => (
        <li class="step" data-i={i}>
          <p class="eyebrow">{String(i + 1).padStart(2, '0')} / {String(steps.length).padStart(2, '0')}</p>
          <h3>{s.title}</h3>
          <p>{s.text}</p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .scrolly {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 48px;
    margin: 32px 0 64px;
  }
  .stage-wrap {
    grid-column: 2;
    grid-row: 1;
  }
  .stage {
    position: sticky;
    top: 12vh;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: #120d22;
    overflow: hidden;
  }
  .anim {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.35s;
  }
  .anim.on {
    opacity: 1;
  }
  .progress {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 14px;
    height: 2px;
    background: rgba(255, 255, 255, 0.12);
    border-radius: 2px;
  }
  .progress span {
    display: block;
    height: 100%;
    width: 0;
    background: var(--accent);
    border-radius: 2px;
  }
  .steps {
    grid-column: 1;
    grid-row: 1;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .step {
    min-height: 85vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    opacity: 0.35;
    transition: opacity 0.3s;
  }
  .step.on {
    opacity: 1;
  }
  .step h3 {
    font-size: 26px;
    letter-spacing: -0.01em;
    margin: 8px 0 10px;
  }
  .step p:not(.eyebrow) {
    color: var(--muted);
    margin: 0;
  }
  @media (max-width: 800px) {
    .scrolly {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .stage-wrap,
    .steps {
      grid-column: 1;
    }
    .stage-wrap {
      position: sticky;
      top: 64px;
      z-index: 1;
    }
    .steps {
      grid-row: 2;
    }
    .step {
      min-height: 70vh;
    }
  }
</style>

<script>
  type Anim = import('lottie-web').AnimationItem;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const root of document.querySelectorAll<HTMLElement>('.scrolly')) {
    const boxes = [...root.querySelectorAll<HTMLElement>('.anim')];
    const steps = [...root.querySelectorAll<HTMLElement>('.step')];
    const bar = root.querySelector<HTMLElement>('.progress span')!;
    const anims: (Anim | null)[] = boxes.map(() => null);
    let lottie: typeof import('lottie-web').default | undefined;
    let active = -1;

    const ensure = async (i: number) => {
      if (anims[i] || !boxes[i]) return;
      lottie ??= (await import('lottie-web/build/player/lottie_svg')).default;
      anims[i] = lottie.loadAnimation({
        container: boxes[i],
        renderer: 'svg',
        loop: false,
        autoplay: false,
        path: boxes[i].dataset.src!,
        rendererSettings: { preserveAspectRatio: 'xMidYMid meet', progressiveLoad: true },
      });
      anims[i]!.addEventListener('DOMLoaded', update);
    };

    // 0..1 progress of a step through the middle band of the viewport.
    const progressOf = (el: HTMLElement) => {
      const r = el.getBoundingClientRect();
      const vh = innerHeight;
      return Math.min(1, Math.max(0, (vh * 0.6 - r.top) / (r.height || 1)));
    };

    function update() {
      let i = steps.findIndex((s) => {
        const r = s.getBoundingClientRect();
        return r.top < innerHeight * 0.6 && r.bottom > innerHeight * 0.4;
      });
      if (i < 0) i = active < 0 ? 0 : active;
      if (i !== active) {
        active = i;
        boxes.forEach((b, j) => b.classList.toggle('on', j === i));
        steps.forEach((s, j) => s.classList.toggle('on', j === i));
        ensure(i);
        ensure(i + 1); // preload the next step
      }
      const a = anims[i];
      const p = reduce ? 0.6 : progressOf(steps[i]);
      bar.style.width = `${((i + p) / steps.length) * 100}%`;
      if (a && a.totalFrames) a.goToAndStop(p * (a.totalFrames - 1), true);
    }

    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        ticking = false;
        update();
      });
    };

    new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting) {
          addEventListener('scroll', onScroll, { passive: true });
          update();
        } else {
          removeEventListener('scroll', onScroll);
        }
      },
      { rootMargin: '300px' },
    ).observe(root);
  }
</script>
