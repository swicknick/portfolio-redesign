---
// Interactive Rive file. The runtime and the .riv load only when the embed nears the viewport,
// it pauses off-screen, and with reduced motion it waits for a click before playing.
interface Pause {
  state: string;
  x: number;
  y: number;
  d: number;
  fill: string;
  icon: string;
}
interface Props {
  src: string;
  label: string;
  stateMachine?: string; // defaults to the file's first state machine
  artboard?: string;
  ratio?: string; // CSS aspect-ratio, e.g. "16 / 9"
  poster?: string;
  caption?: string;
  wide?: boolean;
  pause?: Pause;
  hotspots?: { x: number; y: number; r: number }[];
  priority?: boolean; // first thing on screen: load the poster right away
}

const {
  src,
  label,
  stateMachine,
  artboard,
  ratio = '16 / 9',
  poster,
  caption,
  wide,
  pause,
  hotspots,
  priority,
} = Astro.props;
const spots = [...(hotspots ?? []), ...(pause ? [{ x: pause.x, y: pause.y, r: pause.d / 2 }] : [])];
---

<figure class:list={['rive', { wide }]}>
  <div class="stage" style={`aspect-ratio: ${ratio}`}>
    {
      poster && (
        <img
          class="poster"
          src={poster}
          alt=""
          loading={priority ? 'eager' : 'lazy'}
          fetchpriority={priority ? 'high' : undefined}
          decoding="async"
        />
      )
    }
    <canvas
      data-rive={src}
      data-sm={stateMachine}
      data-artboard={artboard}
      data-pause={pause ? JSON.stringify(pause) : undefined}
      data-spots={spots.length ? JSON.stringify(spots) : undefined}
      role="img"
      aria-label={label}
    ></canvas>
    {
      pause && (
        <svg
          class="paused-icon"
          viewBox="0 0 80 80"
          aria-hidden="true"
          style={`left:${pause.x * 100}%;top:${pause.y * 100}%;width:${pause.d * 100}%`}
        >
          <circle cx="40" cy="40" r="40" fill={pause.fill} />
          <path
            d="M31 24 L56 40 L31 56 Z"
            fill={pause.icon}
            stroke={pause.icon}
            stroke-width="3"
            stroke-linejoin="round"
          />
        </svg>
      )
    }
    <button class="start" type="button" hidden>Play interactive demo</button>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .rive {
    margin: 0;
  }
  .rive.wide {
    grid-column: 1 / -1;
  }
  .stage {
    position: relative;
    width: 100%;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--surface);
    overflow: hidden;
  }
  .poster,
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .poster {
    object-fit: cover;
    transition: opacity 0.4s;
  }
  .stage.live .poster {
    opacity: 0;
  }
  .paused-icon {
    position: absolute;
    transform: translate(-50%, -50%);
    pointer-events: none;
    display: none;
  }
  .stage.paused .paused-icon {
    display: block;
  }
  .start {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    font: inherit;
    font-weight: 600;
    color: var(--text);
    background: rgba(13, 13, 15, 0.8);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 10px 20px;
    cursor: pointer;
  }
  figcaption {
    font-size: 14px;
    color: var(--muted);
    margin-top: 10px;
  }
</style>

<script>
  import wasmUrl from '@rive-app/webgl2/rive.wasm?url';

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Rive plays sound through Web Audio. Keep a handle on its AudioContext so a pause can freeze
  // the sound and the animation on the same frame. Must run before the runtime loads.
  const audio = new Set<AudioContext>();
  const Native = window.AudioContext;
  if (Native) {
    window.AudioContext = class extends Native {
      constructor(...args: ConstructorParameters<typeof AudioContext>) {
        super(...args);
        audio.add(this);
      }
    };
  }
  const suspendAudio = () => audio.forEach((c) => c.suspend());
  const resumeAudio = () => audio.forEach((c) => c.resume());
  const frame = () => new Promise<void>((r) => requestAnimationFrame(() => r()));

  // Browsers keep audio locked until a user gesture, and Rive only unlocks after its own async
  // check, which finishes after the press that triggers a sound. That made the first click
  // silent. So the first press on any demo is held, audio is unlocked, and the press is replayed.
  let audioReady = false;
  async function unlockThenReplay(canvas: HTMLCanvasElement, x: number, y: number) {
    resumeAudio();
    await Promise.all([...audio].map((c) => c.resume().catch(() => {})));
    await frame();
    await frame();
    audioReady = true;
    const init = { bubbles: true, cancelable: true, clientX: x, clientY: y, button: 0, view: window };
    canvas.dispatchEvent(new MouseEvent('mousedown', { ...init, buttons: 1 }));
    canvas.dispatchEvent(new MouseEvent('mouseup', init));
  }

  function gateFirstPress(canvas: HTMLCanvasElement) {
    canvas.addEventListener(
      'mousedown',
      (e) => {
        if (audioReady || !e.isTrusted) return;
        e.stopImmediatePropagation();
        unlockThenReplay(canvas, e.clientX, e.clientY);
      },
      { capture: true },
    );
    canvas.addEventListener(
      'mouseup',
      (e) => {
        if (!audioReady && e.isTrusted) e.stopImmediatePropagation();
      },
      { capture: true },
    );
    // Touch: hold the tap until it ends (the gesture browsers accept), unless it became a scroll.
    let start: { x: number; y: number } | null = null;
    const block = (e: TouchEvent) => {
      if (!audioReady) e.stopImmediatePropagation();
    };
    canvas.addEventListener(
      'touchstart',
      (e) => {
        if (audioReady) return;
        const t = e.touches[0];
        start = { x: t.clientX, y: t.clientY };
        e.stopImmediatePropagation();
      },
      { capture: true, passive: true },
    );
    canvas.addEventListener('touchmove', block, { capture: true, passive: true });
    canvas.addEventListener(
      'touchend',
      (e) => {
        if (audioReady || !start) return;
        e.stopImmediatePropagation();
        const t = e.changedTouches[0];
        const moved = Math.hypot(t.clientX - start.x, t.clientY - start.y) > 10;
        const { x, y } = start;
        start = null;
        if (!moved) unlockThenReplay(canvas, x, y);
      },
      { capture: true },
    );
  }

  // Rive Renderer (WebGL2) so feathering and the rest render exactly as authored in the editor.
  let runtime: Promise<typeof import('@rive-app/webgl2')> | undefined;
  const load = () => (runtime ??= import('@rive-app/webgl2'));

  // At most one embed is user-paused at a time. Touching another demo resumes it first, so its
  // sound and animation never drift apart.
  let pausedResume: (() => void) | null = null;

  // Files boot one at a time: each decode is heavy, and stacking them froze scrolling.
  let queue = Promise.resolve();
  const enqueue = (canvas: HTMLCanvasElement) => {
    queue = queue.then(() => boot(canvas)).catch(() => {});
  };

  async function boot(canvas: HTMLCanvasElement) {
    const { Rive, Layout, Fit, Alignment, RuntimeLoader } = await load();
    let loaded: () => void;
    const ready = new Promise<void>((res) => (loaded = res));
    RuntimeLoader.setWasmUrl(wasmUrl); // self-hosted, version-matched; no third-party CDN
    const stage = canvas.parentElement!;
    const sm = canvas.dataset.sm;
    const pause = canvas.dataset.pause ? JSON.parse(canvas.dataset.pause) : null;
    let state = '';
    let userPaused = false;

    const r = new Rive({
      src: canvas.dataset.rive!,
      canvas,
      artboard: canvas.dataset.artboard || undefined,
      stateMachines: sm || undefined,
      autoplay: true,
      useOffscreenRenderer: true,
      layout: new Layout({ fit: Fit.Contain, alignment: Alignment.Center }),
      onStateChange: (e) => {
        const names = e.data as string[];
        if (names.length) state = names[names.length - 1];
        if (pause && userPaused && state !== pause.state) setPaused(false);
      },
      onLoad: () => {
        if (!sm && r.stateMachineNames.length) r.play(r.stateMachineNames[0]);
        r.resizeDrawingSurfaceToCanvas();
        stage.classList.add('live');
        loaded();
      },
      onLoadError: () => loaded(),
    });

    function setPaused(on: boolean) {
      userPaused = on;
      stage.classList.toggle('paused', on);
      if (on) {
        r.pause();
        suspendAudio();
        pausedResume = () => setPaused(false);
      } else {
        resumeAudio();
        r.play();
        pausedResume = null;
      }
    }

    gateFirstPress(canvas);

    // Fraction-of-width distance from a point to a spot, so circles stay round at any size.
    const hit = (cx: number, cy: number, s: { x: number; y: number; r: number }) => {
      const b = canvas.getBoundingClientRect();
      const dx = (cx - b.left) / b.width - s.x;
      const dy = ((cy - b.top) / b.height - s.y) * (b.height / b.width);
      return Math.hypot(dx, dy) <= s.r;
    };

    // Pointer cursor over the file's clickable elements.
    const spots: { x: number; y: number; r: number }[] = canvas.dataset.spots
      ? JSON.parse(canvas.dataset.spots)
      : [];
    if (spots.length) {
      canvas.addEventListener('mousemove', (e) => {
        canvas.style.cursor = spots.some((s) => hit(e.clientX, e.clientY, s)) ? 'pointer' : '';
      });
      canvas.addEventListener('mouseleave', () => (canvas.style.cursor = ''));
    }

    // Decide play vs pause from the state at the moment of the press, before Rive reacts to it.
    // (Deciding on "click" saw the state Rive had just switched to, so one press played and paused.)
    let pressedWhilePlaying = false;
    canvas.addEventListener(
      'pointerdown',
      (e) => {
        if (pausedResume && !userPaused) pausedResume();
        pressedWhilePlaying =
          !!pause && state === pause.state && hit(e.clientX, e.clientY, { x: pause.x, y: pause.y, r: pause.d / 2 });
        if (audioReady && !userPaused) resumeAudio();
      },
      { capture: true },
    );

    if (pause) {
      canvas.addEventListener('pointerup', () => {
        if (pressedWhilePlaying) setPaused(!userPaused);
        pressedWhilePlaying = false;
      });
    }

    new ResizeObserver(() => r.resizeDrawingSurfaceToCanvas()).observe(canvas);
    new IntersectionObserver(([e]) => {
      if (!stage.classList.contains('live') || userPaused) return;
      // A playing soundtrack keeps running off-screen so sound and picture stay in sync.
      if (pause && state === pause.state) return;
      e.isIntersecting ? r.play() : r.pause();
    }).observe(canvas);

    await ready;
    await frame(); // let the page paint and scroll between files
  }

  const near = new IntersectionObserver(
    (entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        near.unobserve(e.target);
        const canvas = e.target as HTMLCanvasElement;
        if (reduce) {
          const btn = canvas.parentElement!.querySelector<HTMLButtonElement>('.start')!;
          btn.hidden = false;
          btn.addEventListener(
            'click',
            () => {
              btn.hidden = true;
              enqueue(canvas);
            },
            { once: true },
          );
        } else {
          enqueue(canvas);
        }
      }
    },
    { rootMargin: '200px' },
  );

  // Start only after the page has loaded and the visitor first moves, scrolls, touches or types,
  // so the runtime never competes with first paint or a page that's just sitting there.
  const watch = () =>
    document.querySelectorAll<HTMLCanvasElement>('canvas[data-rive]').forEach((c) => near.observe(c));
  const intents = ['pointermove', 'pointerdown', 'touchstart', 'wheel', 'scroll', 'keydown'];
  const onIntent = () => {
    intents.forEach((t) => removeEventListener(t, onIntent));
    watch();
  };
  const arm = () => intents.forEach((t) => addEventListener(t, onIntent, { passive: true }));
  if (document.readyState === 'complete') arm();
  else addEventListener('load', arm, { once: true });
</script>
