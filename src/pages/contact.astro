---
import Base from '../layouts/Base.astro';

// Forwards to Nicholas's inbox through Cloudflare Email Routing.
const EMAIL = 'hello@nicholasrode.com';
const LINKEDIN = 'https://www.linkedin.com/in/nicholas-rode-453a2014/';
---

<Base title="Contact · Nicholas Rode">
  <section class="wrap contact reveal">
    <p class="eyebrow">Contact</p>
    <h1>Let's work together.</h1>
    <p class="lede">
      Interactive motion, Rive and Lottie work, prototypes, or product UI. Tell me what you're
      building and when you need it.
    </p>

    <a class="button" href={`mailto:${EMAIL}`}>{EMAIL}</a>

    <p class="alt">
      Also on <a href={LINKEDIN} rel="noopener">LinkedIn</a>. Based in Vancouver, WA (Pacific time).
    </p>
  </section>
</Base>

<style>
  .contact {
    padding-top: 48px;
  }
  .contact > * {
    max-width: 640px;
  }
  h1 {
    font-size: clamp(36px, 6vw, 60px);
    letter-spacing: -0.02em;
    margin: 16px 0 12px;
  }
  .lede {
    color: var(--muted);
    margin: 0 0 40px;
  }
  .button {
    display: inline-block;
    font-weight: 600;
    color: #fff;
    background: var(--accent);
    border-radius: 999px;
    padding: 14px 28px;
    text-decoration: none;
  }
  .button:hover {
    filter: brightness(1.08);
  }
  .alt {
    margin-top: 32px;
    color: var(--muted);
  }
</style>
