---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const work = await getCollection('work', (w) => !w.data.draft);
  return work.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, summary, role, year, tools } = entry.data;
---

<Base title={`${title} · Nicholas Rode`} description={summary}>
  <article class="wrap">
    <header class="head reveal">
      <a href="/#work" class="back">← All work</a>
      <h1>{title}</h1>
      <p class="summary">{summary}</p>
      <dl class="facts">
        <div><dt class="eyebrow">Role</dt><dd>{role}</dd></div>
        <div><dt class="eyebrow">Year</dt><dd>{year}</dd></div>
        <div><dt class="eyebrow">Tools</dt><dd>{tools.join(', ')}</dd></div>
      </dl>
    </header>
    <div class="body">
      <Content />
    </div>
  </article>
</Base>

<script>
  // Case-study loops play only while on screen. With reduced motion they stay paused and get controls.
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const videos = document.querySelectorAll<HTMLVideoElement>('.body video[data-loop]');
  if (reduce) {
    videos.forEach((v) => (v.controls = true));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) v.play().catch(() => {});
          else v.pause();
        }
      },
      { threshold: 0.25 },
    );
    videos.forEach((v) => io.observe(v));
  }
</script>

<style>
  .head {
    padding: 48px 0 40px;
    border-bottom: 1px solid var(--line);
  }
  .back {
    color: var(--muted);
    text-decoration: none;
    font-size: 14px;
  }
  h1 {
    font-size: clamp(36px, 6vw, 64px);
    letter-spacing: -0.02em;
    line-height: 1.05;
    margin: 24px 0 12px;
  }
  .summary {
    font-size: 21px;
    color: var(--muted);
    max-width: 32em;
    margin: 0 0 32px;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    margin: 0;
  }
  dd {
    margin: 4px 0 0;
  }
  .body {
    padding-top: 24px;
  }
  .body > :global(*) {
    max-width: 680px;
  }
  .body > :global(figure),
  .body > :global(.pair) {
    max-width: none;
    margin: 32px 0;
  }
  .body :global(.pair figure) {
    margin: 0;
  }
  .body :global(figure img),
  .body :global(figure video) {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .body :global(figcaption) {
    font-size: 14px;
    color: var(--muted);
    margin-top: 10px;
  }
  .body :global(.pair) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  @media (max-width: 700px) {
    .body :global(.pair) {
      grid-template-columns: 1fr;
    }
  }
  .body :global(h2) {
    font-size: 26px;
    margin: 48px 0 12px;
    letter-spacing: -0.01em;
  }
  .body :global(li) {
    margin-bottom: 8px;
  }
  .body :global(strong) {
    color: var(--text);
  }
</style>
