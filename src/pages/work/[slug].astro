---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const work = await getCollection('work');
  return work.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, summary, role, year, tools } = entry.data;
---

<Base title={`${title} · Nicholas Rode`} description={summary}>
  <article class="wrap">
    <header class="head reveal">
      <a href="/#work" class="back">← All work</a>
      <h1>{title}</h1>
      <p class="summary">{summary}</p>
      <dl class="facts">
        <div><dt class="eyebrow">Role</dt><dd>{role}</dd></div>
        <div><dt class="eyebrow">Year</dt><dd>{year}</dd></div>
        <div><dt class="eyebrow">Tools</dt><dd>{tools.join(', ')}</dd></div>
      </dl>
    </header>
    <div class="body">
      <Content />
    </div>
  </article>
</Base>

<style>
  .head {
    padding: 48px 0 40px;
    border-bottom: 1px solid var(--line);
  }
  .back {
    color: var(--muted);
    text-decoration: none;
    font-size: 14px;
  }
  h1 {
    font-size: clamp(36px, 6vw, 64px);
    letter-spacing: -0.02em;
    line-height: 1.05;
    margin: 24px 0 12px;
  }
  .summary {
    font-size: 21px;
    color: var(--muted);
    max-width: 32em;
    margin: 0 0 32px;
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    margin: 0;
  }
  dd {
    margin: 4px 0 0;
  }
  .body {
    max-width: 680px;
    padding-top: 24px;
  }
  .body :global(h2) {
    font-size: 26px;
    margin: 48px 0 12px;
    letter-spacing: -0.01em;
  }
  .body :global(li) {
    margin-bottom: 8px;
  }
  .body :global(strong) {
    color: var(--text);
  }
</style>
