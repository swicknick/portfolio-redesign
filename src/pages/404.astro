---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found · Nicholas Rode">
  <section class="wrap missing reveal">
    <p class="eyebrow">404</p>
    <h1>This page doesn't exist.</h1>
    <p class="lede">It may have moved, or the link has a typo. The work is all on the home page.</p>
    <a class="button" href="/#work">See the work</a>
  </section>
</Base>

<style>
  .missing {
    padding-top: 48px;
    padding-bottom: 96px;
  }
  .missing > * {
    max-width: 640px;
  }
  h1 {
    font-size: clamp(36px, 6vw, 60px);
    letter-spacing: -0.02em;
    margin: 16px 0 12px;
  }
  .lede {
    color: var(--muted);
    margin: 0 0 40px;
  }
  .button {
    display: inline-block;
    font-weight: 600;
    color: #fff;
    background: var(--accent);
    border-radius: 999px;
    padding: 14px 28px;
    text-decoration: none;
  }
  .button:hover {
    filter: brightness(1.08);
  }
</style>
