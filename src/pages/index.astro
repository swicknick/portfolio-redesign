---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ShaderHero from '../components/ShaderHero.astro';

const work = (await getCollection('work', (w) => !w.data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const groups = [
  { key: 'ui-motion', label: 'Product UI motion' },
  { key: 'product', label: 'Product' },
  { key: 'motion', label: 'Explaining complex products' },
  { key: 'concept', label: 'Concepts' },
] as const;
---

<Base>
  <ShaderHero>
    <div class="hero reveal">
      <p class="eyebrow">Product & Interactive Motion Designer</p>
      <h1>I make complex products easy to understand, and I build the tools that get motion shipped.</h1>
      <p class="lede">
        Interactive motion designer with a builder's mindset, based in Vancouver, WA. Everything on
        this page is built to run smooth, on purpose.
      </p>
    </div>
  </ShaderHero>

  <section class="wrap">
    <a href="/reel" class="featured reveal">
      <div class="featured-media">
        <img src="/reel/poster.jpg" alt="Frame from Nicholas Rode's 2025 motion reel" width="1920" height="1080" />
        <span class="play" aria-hidden="true">▶</span>
      </div>
      <div class="featured-body">
        <p class="eyebrow">Showreel · 2025</p>
        <h2>Motion reel</h2>
        <p>Product UI motion, interactive Rive work, and brand animation for B2B SaaS and AI products.</p>
        <span class="more">Watch the reel →</span>
      </div>
    </a>
  </section>

  <section class="wrap" id="work">
    {
      groups.map((g) => {
        const items = work.filter((w) => w.data.category === g.key);
        return (
          items.length > 0 && (
            <div class="group">
              <h3 class="eyebrow">{g.label}</h3>
              <div class="grid">
                {items.map((w) => (
                  <a href={`/work/${w.id}`} class="card">
                    <div class="thumb">
                      {w.data.cover && <img src={w.data.cover} alt="" loading="lazy" decoding="async" />}
                    </div>
                    <h4>{w.data.title}</h4>
                    <p>{w.data.summary}</p>
                    <span class="meta">
                      {w.data.role} · {w.data.year}
                    </span>
                  </a>
                ))}
              </div>
            </div>
          )
        );
      })
    }
  </section>
</Base>

<style>
  .hero .eyebrow {
    color: rgba(237, 237, 240, 0.7);
  }
  h1 {
    font-size: clamp(34px, 5.5vw, 60px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    font-weight: 600;
    max-width: 16em;
    margin: 16px 0 24px;
  }
  .lede {
    color: var(--muted);
    max-width: 38em;
    font-size: 19px;
    margin: 0;
  }
  .featured {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    background: var(--surface);
    animation-delay: 0.1s;
  }
  .featured-media {
    position: relative;
    min-height: 320px;
    background: #1b1b1b;
  }
  .featured-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .play {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 64px;
    height: 64px;
    margin: -32px 0 0 -32px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: rgba(13, 13, 15, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.25);
    font-size: 20px;
    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .featured:hover .play {
    transform: scale(1.08);
  }
  .featured-body {
    padding: 32px;
    align-self: center;
  }
  .featured h2 {
    font-size: 32px;
    margin: 8px 0 12px;
    letter-spacing: -0.01em;
  }
  .featured p {
    color: var(--muted);
    margin: 0 0 20px;
  }
  .more {
    color: var(--accent);
    font-weight: 500;
  }
  .group {
    margin-top: 80px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 24px;
    margin-top: 20px;
  }
  .card {
    text-decoration: none;
    display: block;
  }
  .thumb {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--line);
    overflow: hidden;
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .thumb:empty {
    background: radial-gradient(120% 90% at 20% 20%, #ff7a45 0%, #7a1f5c 45%, #120a1f 100%);
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .card:hover .thumb {
    transform: translateY(-4px);
  }
  .card h4 {
    font-size: 20px;
    margin: 16px 0 6px;
  }
  .card p {
    color: var(--muted);
    margin: 0 0 8px;
    font-size: 15px;
  }
  .meta {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .featured {
      grid-template-columns: 1fr;
    }
    .featured-media {
      min-height: 220px;
    }
    .featured-body {
      padding: 24px;
    }
  }
</style>
