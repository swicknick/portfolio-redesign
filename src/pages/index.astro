---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const featured = work.find((w) => w.data.category === 'featured');

const groups = [
  { key: 'product', label: 'Product' },
  { key: 'motion', label: 'Interactive motion for AI & data' },
  { key: 'systems', label: 'Systems' },
] as const;
---

<Base>
  <section class="wrap hero reveal">
    <p class="eyebrow">Product Designer · Motion, Prototyping & AI Tools</p>
    <h1>I make complex products easy to understand, and I build the tools that get motion shipped.</h1>
    <p class="lede">
      Vancouver-based designer working where motion, product, and code meet. I design interactive
      experiences for AI and data companies, and build AI-powered tools that close the gap between
      design and production.
    </p>
  </section>

  {
    featured && (
      <section class="wrap">
        <a href={`/work/${featured.id}`} class="featured reveal">
          <div class="featured-media">
            {/* TODO: live shader demo goes here */}
            <span class="eyebrow">Live demo coming soon</span>
          </div>
          <div class="featured-body">
            <p class="eyebrow">Featured · {featured.data.year}</p>
            <h2>{featured.data.title}</h2>
            <p>{featured.data.summary}</p>
            <span class="more">Read the case study →</span>
          </div>
        </a>
      </section>
    )
  }

  <section class="wrap" id="work">
    {
      groups.map((g) => {
        const items = work.filter((w) => w.data.category === g.key);
        return (
          items.length > 0 && (
            <div class="group">
              <h3 class="eyebrow">{g.label}</h3>
              <div class="grid">
                {items.map((w) => (
                  <a href={`/work/${w.id}`} class="card">
                    <div class="thumb" />
                    <h4>{w.data.title}</h4>
                    <p>{w.data.summary}</p>
                    <span class="meta">
                      {w.data.role} · {w.data.year}
                    </span>
                  </a>
                ))}
              </div>
            </div>
          )
        );
      })
    }
  </section>
</Base>

<style>
  .hero {
    padding-top: 72px;
    padding-bottom: 64px;
  }
  h1 {
    font-size: clamp(34px, 5.5vw, 60px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    font-weight: 600;
    max-width: 16em;
    margin: 16px 0 24px;
  }
  .lede {
    color: var(--muted);
    max-width: 38em;
    font-size: 19px;
    margin: 0;
  }
  .featured {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    text-decoration: none;
    background: var(--surface);
    animation-delay: 0.1s;
  }
  .featured-media {
    min-height: 320px;
    display: grid;
    place-items: center;
    background: radial-gradient(120% 90% at 20% 20%, #ff7a45 0%, #7a1f5c 45%, #120a1f 100%);
  }
  .featured-media .eyebrow {
    color: rgba(255, 255, 255, 0.75);
  }
  .featured-body {
    padding: 32px;
    align-self: center;
  }
  .featured h2 {
    font-size: 32px;
    margin: 8px 0 12px;
    letter-spacing: -0.01em;
  }
  .featured p {
    color: var(--muted);
    margin: 0 0 20px;
  }
  .more {
    color: var(--accent);
    font-weight: 500;
  }
  .group {
    margin-top: 80px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 24px;
    margin-top: 20px;
  }
  .card {
    text-decoration: none;
    display: block;
  }
  .thumb {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--line);
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .card:hover .thumb {
    transform: translateY(-4px);
  }
  .card h4 {
    font-size: 20px;
    margin: 16px 0 6px;
  }
  .card p {
    color: var(--muted);
    margin: 0 0 8px;
    font-size: 15px;
  }
  .meta {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .featured {
      grid-template-columns: 1fr;
    }
    .featured-media {
      min-height: 220px;
    }
    .featured-body {
      padding: 24px;
    }
  }
</style>
