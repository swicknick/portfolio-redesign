---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ShaderHero from '../components/ShaderHero.astro';

const work = (await getCollection('work', (w) => !w.data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const groups = [
  { key: 'ui-motion', label: 'Product UI motion' },
  { key: 'product', label: 'Product' },
  { key: 'motion', label: 'Explaining complex products' },
  { key: 'concept', label: 'Concepts' },
] as const;

---

<Base>
  <ShaderHero>
    <div class="hero reveal">
      <p class="eyebrow">Product & Interactive Motion Designer</p>
      <h1>Complex products, made clear.</h1>
      <p class="lede">
        I design motion that makes products easy to understand, and build the tools that get it
        shipped. Everything on this page is engineered to run silky smooth. On purpose.
      </p>
    </div>
  </ShaderHero>


  <section class="wrap" id="work">
    {
      groups.map((g) => {
        const items = work.filter((w) => w.data.category === g.key);
        return (
          items.length > 0 && (
            <div class="group">
              <h2 class="eyebrow group-label">{g.label}</h2>
              <div class="grid">
                {items.map((w) => (
                  <a href={`/work/${w.id}`} class="card">
                    <div class="thumb">
                      {w.data.coverVideo ? (
                        <video
                          data-thumb
                          src={w.data.coverVideo}
                          poster={w.data.cover}
                          muted
                          loop
                          playsinline
                          preload="none"
                          aria-hidden="true"
                        />
                      ) : (
                        w.data.cover && <img src={w.data.cover} alt="" loading="lazy" decoding="async" />
                      )}
                    </div>
                    <h3>{w.data.title}</h3>
                    <p>{w.data.summary}</p>
                    <span class="meta">
                      {w.data.role} · {w.data.year}
                    </span>
                  </a>
                ))}
              </div>
            </div>
          )
        );
      })
    }
  </section>
</Base>

<script>
</script>

<style>
  .hero {
    /* Shrink-wrap to the headline so the supporting line can be sized against it. */
    width: fit-content;
    max-width: 100%;
  }
  .hero .eyebrow {
    color: rgba(237, 237, 240, 0.7);
    margin-top: 0;
  }
  h1 {
    font-size: clamp(37px, 6.05vw, 66px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    font-weight: 600;
    max-width: 16em;
    margin: 16px 0 24px;
  }
  .lede {
    color: var(--muted);
    /* Stays well inside the headline's width: no line ending lands near its edge. */
    max-width: 82%;
    text-wrap: pretty;
    font-size: 19px;
    margin: 0;
  }
  .group {
    margin-top: 80px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 24px;
    margin-top: 20px;
  }
  .card {
    text-decoration: none;
    display: block;
  }
  .thumb {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--line);
    overflow: hidden;
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .thumb:empty {
    background: radial-gradient(120% 90% at 20% 20%, #ff7a45 0%, #7a1f5c 45%, #120a1f 100%);
  }
  .thumb img,
  .thumb video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .card:hover .thumb {
    transform: translateY(-4px);
  }
  .group-label {
    margin: 12px 0;
  }
  .card h3 {
    font-size: 20px;
    margin: 16px 0 6px;
  }
  .card p {
    color: var(--muted);
    margin: 0 0 8px;
    font-size: 15px;
  }
  .meta {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
  }
  @media (max-width: 760px) {
  }
</style>
