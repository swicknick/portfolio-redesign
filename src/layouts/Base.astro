---
import '@fontsource-variable/inter-tight';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Nicholas Rode, Product & Motion Designer',
  description = 'Vancouver-based designer working where motion, product, and code meet.',
} = Astro.props;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <header class="wrap nav">
      <a href="/" class="logo">Nicholas Rode</a>
      <nav>
        <a href="/#work" aria-current={path.startsWith('/work') ? 'page' : undefined}>Work</a>
        <a href="/reel" aria-current={path === '/reel' ? 'page' : undefined}>Reel</a>
        <a href="/about" aria-current={path === '/about' ? 'page' : undefined}>About</a>
        <a href="/contact" class="cta">Contact</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="wrap footer">
      <span>Vancouver, PST · Available for freelance</span>
      <a href="/contact">Get in touch →</a>
    </footer>
  </body>
</html>

<style>
  .nav {
    position: relative;
    z-index: 10;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 24px;
    padding-bottom: 24px;
  }
  .logo {
    font-weight: 600;
    text-decoration: none;
  }
  nav {
    display: flex;
    gap: 20px;
    align-items: center;
  }
  nav a {
    text-decoration: none;
    color: var(--muted);
    font-size: 15px;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--text);
  }
  nav .cta {
    color: var(--text);
    border: 1px solid var(--line);
    padding: 6px 14px;
    border-radius: 999px;
  }
  .footer {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 120px;
    padding-top: 24px;
    padding-bottom: 40px;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 14px;
  }
</style>
